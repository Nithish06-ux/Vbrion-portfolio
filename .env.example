# ==========================================
# vbrion Portfolio Project Environment Config
# ==========================================

# Server Port
PORT=5000

# Client API URL
VITE_API_URL=http://localhost:5000/api

# Database Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/vbrion_portfolio

# Email Recipient for client enquiries
CONTACT_EMAIL=info@vbrion.com

# SMTP Settings for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="vbrion Inquiries" <notifications@vbrion.com>

# Optional Gemini API Key for Live AI Assistant
GEMINI_API_KEY=
